# Copy to .env and fill in. Secrets have NO defaults in code.
SR_SERVER_SECRET=
SR_DATABASE_URL=sqlite:///./socialreset.db
SR_JWT_TTL_SECONDS=300
SR_PAIRING_TTL_SECONDS=300
SR_RESET_SESSION_TTL_SECONDS=86400
SR_EVENT_TTL_SECONDS=86400
SR_CLEANUP_INTERVAL_SECONDS=60
SR_MAX_REQUEST_BYTES=8192
SR_MAX_CONCURRENT_WS_PER_DEVICE=2
SR_WS_IDLE_TIMEOUT_SECONDS=120
SR_CORS_ALLOWED_ORIGINS=
SR_LOG_LEVEL=INFO